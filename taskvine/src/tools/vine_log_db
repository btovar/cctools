def cmd_refresh(conn, directory):
    """Update the database by reading log files from the last saved position (append new data)."""
    global start_time_us
    txn_log, perf_log, debug_log = find_log_files(Path(directory))
    if not txn_log and not perf_log and not debug_log:
        print("No log files found in directory.")
        return
    # Ensure start_time_us is set so new rows get time_us/time_relative populated
    if start_time_us is None:
        start_time_us = get_start_time_us(conn)
    if start_time_us is None:
        cursor = conn.cursor()
        try:
            cursor.execute(
                "SELECT MIN(time_us) FROM (SELECT MIN(time_us) FROM transactions UNION ALL "
                "SELECT MIN(time_us) FROM performance UNION ALL SELECT MIN(time_us) FROM debug)"
            )
            result = cursor.fetchone()
            if result and result[0]:
                start_time_us = result[0]
        except sqlite3.OperationalError:
            pass  # tables may not exist
        if start_time_us is None and (txn_log or perf_log or debug_log):
            find_earliest_timestamp(txn_log, perf_log, debug_log)
    if start_time_us is not None:
        set_start_time_us(conn, start_time_us)
    ensure_log_read_position_table(conn)
    path_str = lambda p: str(Path(p).resolve()) if p else None

    if txn_log and txn_log.exists():
        pos = get_read_position(conn, "transactions")
        if pos and pos["file_path"] == path_str(txn_log):
            result = parse_transaction_log(
                conn, txn_log, pos["last_byte_position"], pos["last_line_number"]
            )
            if result:
                save_read_position(conn, "transactions", txn_log, result[0], result[1])
        else:
            cursor = conn.cursor()
            for table in (
                "txns_manager",
                "txns_worker",
                "txns_category",
                "txns_waiting",
                "txns_running",
                "txns_waiting_retrieval",
                "txns_retrieved",
            ):
                try:
                    cursor.execute(f"DELETE FROM {table}")
                except sqlite3.OperationalError:
                    pass
            try:
                conn.commit()
            except sqlite3.OperationalError:
                pass
            result = parse_transaction_log(conn, txn_log)
            if result:
                save_read_position(conn, "transactions", txn_log, result[0], result[1])

    if perf_log and perf_log.exists():
        pos = get_read_position(conn, "performance")
        if pos and pos["file_path"] == path_str(perf_log):
            result = parse_performance_log(
                conn, perf_log, pos["last_byte_position"], pos["last_line_number"]
            )
            if result is not None:
                save_read_position(conn, "performance", perf_log, result[0], result[1])
        else:
            cursor = conn.cursor()
            try:
                cursor.execute("DELETE FROM performance")
                conn.commit()
            except sqlite3.OperationalError:
                pass  # table may not exist yet
            result = parse_performance_log(conn, perf_log)
            if result is not None:
                save_read_position(conn, "performance", perf_log, result[0], result[1])

    if debug_log and debug_log.exists():
        pos = get_read_position(conn, "debug")
        if pos and pos["file_path"] == path_str(debug_log):
            result = parse_debug_log(
                conn, debug_log, pos["last_byte_position"], pos["last_line_number"]
            )
            if result:
                save_read_position(conn, "debug", debug_log, result[0], result[1])
        else:
            cursor = conn.cursor()
            try:
                cursor.execute("DELETE FROM debug")
                conn.commit()
            except sqlite3.OperationalError:
                pass  # table may not exist yet
            result = parse_debug_log(conn, debug_log)
            if result:
                save_read_position(conn, "debug", debug_log, result[0], result[1])

    print("Refresh complete.")


def _parse_txn_manager_row(line_num, time_us, time_relative, manager_pid, event_data, raw_line):
    """Parse MANAGER / LIBRARY / APPLICATION lines. Returns (table_name, row_list, resource_json)."""
    if event_data.startswith("MANAGER"):
        event_type = "MANAGER"
    elif event_data.startswith("LIBRARY"):
        event_type = "LIBRARY"
    elif event_data.startswith("APPLICATION"):
        event_type = "APPLICATION"
    else:
        return None
    row = [line_num, time_us, time_relative, manager_pid, event_type, event_data, raw_line]
    return ("txns_manager", row, None)


def _parse_txn_worker_row(line_num, time_us, time_relative, manager_pid, event_data, raw_line):
    """Parse WORKER lines. Returns (table_name, row_list, resource_json)."""
    if not event_data.startswith("WORKER"):
        return None
    row = [line_num, time_us, time_relative, manager_pid, "WORKER", event_data, raw_line]
    return ("txns_worker", row, None)


def _parse_txn_category_row(line_num, time_us, time_relative, event_data, raw_line):
    """Parse CATEGORY lines. Returns (table_name, row_list, resource_json) or None."""
    m = _CATEGORY_RE.match(event_data)
    if not m:
        return None
    name, kind, sub = m.group(1), m.group(2), m.group(3)
    event_type = kind if sub is None else f"{kind} {sub}"
    json_str = m.group(4) if m.lastindex >= 4 and m.group(4) else None
    row = [line_num, time_us, time_relative, name, event_type, None, raw_line]
    return ("txns_category", row, json_str)


def _parse_txn_task_row(line_num, time_us, time_relative, event_data, raw_line, current_attempts):
    """Parse TASK WAITING / RUNNING / WAITING_RETRIEVAL (not RETRIEVED). Returns (table_name, row_list, resource_json) or None."""
    if _RETRIEVED_RE.match(event_data):
        return None
    m = _TASK_WAITING_RETRIEVAL_RE.match(event_data)
    if m:
        task_id = int(m.group(1))
        row = [line_num, time_us, time_relative, task_id, current_attempts.get(task_id, 0), raw_line]
        return ("txns_waiting_retrieval", row, None)
    m = _TASK_WAITING_RE.match(event_data)
    if m:
        task_id = int(m.group(1))
        attempt_number = int(m.group(4))
        current_attempts[task_id] = attempt_number
        category = m.group(2)
        json_str = m.group(5) if m.lastindex >= 5 and m.group(5) else None
        row = [line_num, time_us, time_relative, task_id, category, attempt_number, None, raw_line]
        return ("txns_waiting", row, json_str)
    m = _TASK_RUNNING_RE.match(event_data)
    if m:
        task_id = int(m.group(1))
        worker_id = m.group(2)
        json_str = m.group(4) if m.lastindex >= 4 and m.group(4) else None
        row = [line_num, time_us, time_relative, task_id, current_attempts.get(task_id, 0), worker_id, None, raw_line]
        return ("txns_running", row, json_str)
    return None


def parse_transaction_log(conn, log_file, start_byte=None, start_line_num=None):
    """Parse transaction log file and insert into database.
    If start_byte and start_line_num are set, resume from that position (for refresh).
    Returns (last_byte_position, last_line_number) for saving read position.
    """
    # time manager_pid MANAGER manager_pid START|END time_from_origin
    # time manager_pid WORKER worker_id CONNECTION host:port
    # time manager_pid WORKER worker_id DISCONNECTION (UNKNOWN|IDLE_OUT|FAST_ABORT|FAILURE|STATUS_WORKER|EXPLICIT|XFER_ERRORS)
    # time manager_pid WORKER worker_id RESOURCES {resources}
    # time manager_pid WORKER worker_id CACHE_UPDATE filename size_in_mb wall_time_us start_time_us
    # time manager_pid WORKER worker_id TRANSFER (INPUT|OUTPUT) filename size_in_mb wall_time_us start_time_us
    # time manager_pid CATEGORY name MAX {resources_max_per_task}
    # time manager_pid CATEGORY name MIN {resources_min_per_task_per_worker}
    # time manager_pid CATEGORY name FIRST (FIXED|MAX|MIN_WASTE|MAX_THROUGHPUT) {resources_requested}
    # time manager_pid TASK task_id WAITING category_name (FIRST_RESOURCES|MAX_RESOURCES) attempt_number {resources_requested}
    # time manager_pid TASK task_id RUNNING worker_id (FIRST_RESOURCES|MAX_RESOURCES) {resources_allocated}
    # time manager_pid TASK task_id WAITING_RETRIEVAL worker_id
    # time manager_pid TASK task_id RETRIEVED (SUCCESS|UNKNOWN|INPUT_MISSING|OUTPUT_MISSING|STDOUT_MISSING|SIGNAL|RESOURCE_EXHAUSTION|MAX_RETRIES|MAX_END_TIME|MAX_WALL_TIME|FORSAKEN) {limits_exceeded} {resources_measured}
    # time manager_pid TASK task_id DONE (SUCCESS|UNKNOWN|INPUT_MISSING|OUTPUT_MISSING|STDOUT_MISSING|SIGNAL|RESOURCE_EXHAUSTION|MAX_RETRIES|MAX_END_TIME|MAX_WALL_TIME|FORSAKEN) exit_code
    # time manager_pid LIBRARY library_id (WAITING|SENT|STARTED|FAILURE) worker_id
    # time manager_pid APPLICATION message*

    global start_time_us

    cursor = conn.cursor()
    resume = start_byte is not None and start_line_num is not None
    if resume:
        next_line_num = start_line_num + 1
        bytes_read_before = start_byte
    else:
        next_line_num = 1
        bytes_read_before = 0

    # Create transactions table per event type, and state with line numbers
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_manager (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            manager_pid INTEGER,
            event_type TEXT,
            event_data TEXT,
            raw_line TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_worker (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            manager_pid INTEGER,
            event_type TEXT,
            event_data TEXT,
            raw_line TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_category (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            name TEXT,
            event_type TEXT,
            resources INTEGER REFERENCES resources(id),
            raw_line TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_waiting (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            task_id INTEGER,
            attempt_number INTEGER,
            category TEXT,
            resources INTEGER REFERENCES resources(id),
            raw_line TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_running (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            task_id INTEGER,
            attempt_number INTEGER,
            worker_id TEXT,
            resources INTEGER REFERENCES resources(id),
            raw_line TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_waiting_retrieval (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            task_id INTEGER,
            attempt_number INTEGER,
            raw_line TEXT
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS txns_retrieved (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            task_id INTEGER,
            attempt_number INTEGER,
            result TEXT,
            exit_code INTEGER,
            limits INTEGER REFERENCES resources(id),
            resources INTEGER REFERENCES resources(id),
            raw_line TEXT
        )
    """)

    # View unifies all transaction tables for queries; task_id is NULL for non-task events.
    cursor.execute("""
        CREATE VIEW IF NOT EXISTS txns AS
            SELECT line_number, time_us, time_relative, raw_line, NULL AS task_id FROM txns_manager
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, NULL AS task_id FROM txns_worker
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, NULL AS task_id FROM txns_category
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, task_id FROM txns_waiting
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, task_id FROM txns_running
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, task_id FROM txns_waiting_retrieval
            UNION ALL
            SELECT line_number, time_us, time_relative, raw_line, task_id FROM txns_retrieved
            ORDER BY line_number
    """)

    # Resources table: one row per limits_exceeded or resources_measured with at least one value (no all-NULL rows).
    resource_cols = ", ".join(f"{n} REAL" for n in _RESOURCE_NAMES)
    cursor.execute(f"""
        CREATE TABLE IF NOT EXISTS resources (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            {resource_cols}
        )
    """)

    # INSERT statements for each transaction table (for executemany).
    _INSERT_MANAGER = """INSERT INTO txns_manager (line_number, time_us, time_relative, manager_pid, event_type, event_data, raw_line) VALUES (?,?,?,?,?,?,?)"""
    _INSERT_WORKER = """INSERT INTO txns_worker (line_number, time_us, time_relative, manager_pid, event_type, event_data, raw_line) VALUES (?,?,?,?,?,?,?)"""
    _INSERT_CATEGORY = """INSERT INTO txns_category (line_number, time_us, time_relative, name, event_type, resources, raw_line) VALUES (?,?,?,?,?,?,?)"""
    _INSERT_TASK_WAITING = """INSERT INTO txns_waiting (line_number, time_us, time_relative, task_id, category, attempt_number, resources, raw_line) VALUES (?,?,?,?,?,?,?,?)"""
    _INSERT_TASK_RUNNING = """INSERT INTO txns_running (line_number, time_us, time_relative, task_id, attempt_number, worker_id, resources, raw_line) VALUES (?,?,?,?,?,?,?,?)"""
    _INSERT_TASK_WAITING_RETRIEVAL = """INSERT INTO txns_waiting_retrieval (line_number, time_us, time_relative, task_id, attempt_number, raw_line) VALUES (?,?,?,?,?,?)"""
    _INSERT_TASK_RETRIEVED = """INSERT INTO txns_retrieved (line_number, time_us, time_relative, task_id, attempt_number, result, exit_code, limits, resources, raw_line) VALUES (?,?,?,?,?,?,?,?,?,?)"""

    _TXN_INSERT_SQL = {
        "txns_manager": _INSERT_MANAGER,
        "txns_worker": _INSERT_WORKER,
        "txns_category": _INSERT_CATEGORY,
        "txns_waiting": _INSERT_TASK_WAITING,
        "txns_running": _INSERT_TASK_RUNNING,
        "txns_waiting_retrieval": _INSERT_TASK_WAITING_RETRIEVAL,
        "txns_retrieved": _INSERT_TASK_RETRIEVED,
    }

    def flush_batch(table_name):
        b = batches[table_name]
        if b:
            cursor.executemany(_TXN_INSERT_SQL[table_name], b)
            batches[table_name] = []

    BATCH_SIZE = 5000
    total_bytes = max(1, log_file.stat().st_size)
    start_time = time.time()
    last_pct = None
    label = f"Parsing {log_file.name}" if not resume else f"Refreshing {log_file.name}"
    batches = {
        "txns_manager": [],
        "txns_worker": [],
        "txns_category": [],
        "txns_waiting": [],
        "txns_running": [],
        "txns_waiting_retrieval": [],
        "txns_retrieved": [],
    }
    current_attempts = {}

    count = 0
    retrieved_count = 0
    last_line_num = start_line_num if resume else 0
    bytes_read_this_run = 0

    with open(log_file, "r") as f:
        if resume:
            f.seek(start_byte)
        for line in f:
            line_num = next_line_num
            next_line_num += 1
            last_line_num = line_num
            bytes_read_this_run += len(line.encode("utf-8", errors="replace"))
            last_bytes_read = bytes_read_before + bytes_read_this_run
            if line_num % 10000 == 0 or line_num == 1:
                last_pct = print_parse_progress(
                    last_bytes_read, total_bytes, line_num, start_time, label, last_pct
                )
            line_stripped = line.strip()
            if not line_stripped or line_stripped.startswith("#"):
                continue

            parts = line_stripped.split(None, 2)
            if len(parts) < 3:
                continue

            timestamp_str, manager_pid_str, event_data = parts[0], parts[1], parts[2]
            timestamp_us = parse_timestamp_us(timestamp_str)
            if timestamp_us is None:
                continue
            manager_pid = int(manager_pid_str) if manager_pid_str.isdigit() else None
            time_relative = format_relative_time(timestamp_us)

            # RETRIEVED: insert resources for limits/resources, then one row into txns_retrieved.
            retrieved_match = _RETRIEVED_RE.match(event_data)
            if retrieved_match:
                t_id = int(retrieved_match.group(1))
                result_str = retrieved_match.group(2)
                exit_code_val = int(retrieved_match.group(3))
                rest = retrieved_match.group(4)
                limits_str, resources_str = _parse_two_json_objects(rest)
                limits_id = _insert_resource_row(cursor, limits_str) if limits_str else None
                resources_id = _insert_resource_row(cursor, resources_str) if resources_str else None
                row = (
                    line_num,
                    timestamp_us,
                    time_relative,
                    t_id,
                    current_attempts.get(t_id, 0),
                    result_str,
                    exit_code_val,
                    limits_id,
                    resources_id,
                    line_stripped,
                )
                batches["txns_retrieved"].append(row)
                if len(batches["txns_retrieved"]) >= BATCH_SIZE:
                    flush_batch("txns_retrieved")
                retrieved_count += 1
                count += 1
                continue

            # Dispatch to per-event parsers; each returns (table_name, row_list, resource_json) or None.
            parsed = None
            if event_data.startswith("MANAGER") or event_data.startswith("LIBRARY") or event_data.startswith("APPLICATION"):
                parsed = _parse_txn_manager_row(line_num, timestamp_us, time_relative, manager_pid, event_data, line_stripped)
            elif event_data.startswith("WORKER"):
                parsed = _parse_txn_worker_row(line_num, timestamp_us, time_relative, manager_pid, event_data, line_stripped)
            elif event_data.startswith("CATEGORY"):
                parsed = _parse_txn_category_row(line_num, timestamp_us, time_relative, event_data, line_stripped)
            elif event_data.startswith("TASK"):
                parsed = _parse_txn_task_row(line_num, timestamp_us, time_relative, event_data, line_stripped, current_attempts)

            if parsed is None:
                continue
            table_name, row_list, resource_json = parsed
            if resource_json:
                rid = _insert_resource_row(cursor, resource_json)
                if table_name == "txns_category":
                    row_list[5] = rid
                elif table_name in ("txns_waiting", "txns_running"):
                    row_list[6] = rid
            row = tuple(row_list)
            batches[table_name].append(row)
            if len(batches[table_name]) >= BATCH_SIZE:
                flush_batch(table_name)
            count += 1

    for table_name in batches:
        flush_batch(table_name)

    # Indexes on base tables (txns is a view and cannot be indexed).
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_manager_time ON txns_manager(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_manager_line ON txns_manager(line_number)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_worker_time ON txns_worker(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_worker_line ON txns_worker(line_number)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_category_time ON txns_category(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_category_line ON txns_category(line_number)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_waiting_time ON txns_waiting(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_waiting_task ON txns_waiting(task_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_running_time ON txns_running(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_running_task ON txns_running(task_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_running_worker ON txns_running(worker_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_waiting_retrieval_time ON txns_waiting_retrieval(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_waiting_retrieval_task ON txns_waiting_retrieval(task_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_retrieved_time ON txns_retrieved(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_retrieved_task ON txns_retrieved(task_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_retrieved_result ON txns_retrieved(result)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_retrieved_limits ON txns_retrieved(limits)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_txn_task_retrieved_resources ON txns_retrieved(resources)")

    print_parse_progress(
        bytes_read_before + bytes_read_this_run,
        total_bytes,
        last_line_num,
        start_time,
        label,
        None,
    )
    print()
    conn.commit()
    print(f"Parsed {count} transaction log entries")
    if retrieved_count:
        print(f"Parsed {retrieved_count} RETRIEVED entries into txns_retrieved")
    return (bytes_read_before + bytes_read_this_run, last_line_num)


def parse_performance_log(conn, log_file, start_byte=None, start_line_num=None):
    """Parse performance log file and insert into database.
    If start_byte and start_line_num are set, resume from that position (for refresh).
    Returns (last_byte_position, last_line_number) for saving read position, or None if no header.
    """
    global start_time_us

    cursor = conn.cursor()
    resume = start_byte is not None and start_line_num is not None
    if resume:
        next_line_num = start_line_num + 1
        bytes_read_before = start_byte
    else:
        next_line_num = 1
        bytes_read_before = 0

    # Read header to get column names
    header = None
    with open(log_file, "r") as f:
        for line in f:
            if line.startswith("#"):
                header = line[1:].strip().split()
                break

    if not header:
        print("Warning: Could not find performance log header")
        return None

    # Create performance table with dynamic columns and line numbers
    columns = [
        "id INTEGER PRIMARY KEY AUTOINCREMENT",
        "line_number INTEGER",
        "time_us INTEGER",
        "time_relative TEXT",
    ]
    for col in header[1:]:  # Skip timestamp column
        col_clean = re.sub(r"[^a-zA-Z0-9_]", "_", col)
        columns.append(f"{col_clean} REAL")

    create_sql = f'CREATE TABLE IF NOT EXISTS performance ({", ".join(columns)})'
    cursor.execute(create_sql)

    num_values = 3 + len(header) - 1
    placeholders = ["?"] * num_values
    insert_sql = f"""
        INSERT INTO performance
        (line_number, time_us, time_relative, {", ".join([re.sub(r'[^a-zA-Z0-9_]', '_', col) for col in header[1:]])})
        VALUES ({", ".join(placeholders)})
    """
    BATCH_SIZE = 5000

    total_bytes = max(1, log_file.stat().st_size)
    start_time = time.time()
    last_pct = None
    label = f"Parsing {log_file.name}" if not resume else f"Refreshing {log_file.name}"
    batch = []
    count = 0
    last_line_num = start_line_num if resume else 0
    bytes_read_this_run = 0
    with open(log_file, "r") as f:
        if resume:
            f.seek(start_byte)
        for line in f:
            line_num = next_line_num
            next_line_num += 1
            last_line_num = line_num
            bytes_read_this_run += len(line.encode("utf-8", errors="replace"))
            last_bytes_read = bytes_read_before + bytes_read_this_run
            if line_num % 10000 == 0 or line_num == 1:
                last_pct = print_parse_progress(
                    last_bytes_read, total_bytes, line_num, start_time, label, last_pct
                )
            line = line.strip()
            if not line or line.startswith("#"):
                continue

            parts = line.split()
            if len(parts) < len(header):
                continue

            timestamp_str = parts[0]
            timestamp_us = parse_timestamp_us(timestamp_str)
            if timestamp_us is None:
                continue

            time_relative = format_relative_time(timestamp_us)
            values = [line_num, timestamp_us, time_relative]
            for val_str in parts[1:]:
                try:
                    values.append(float(val_str))
                except ValueError:
                    values.append(None)

            batch.append(values)
            count += 1
            if len(batch) >= BATCH_SIZE:
                cursor.executemany(insert_sql, batch)
                batch = []

    if batch:
        cursor.executemany(insert_sql, batch)

    cursor.execute("CREATE INDEX IF NOT EXISTS idx_perf_time ON performance(time_us)")
    cursor.execute(
        "CREATE INDEX IF NOT EXISTS idx_perf_line ON performance(line_number)"
    )

    print_parse_progress(
        bytes_read_before + bytes_read_this_run,
        total_bytes,
        last_line_num,
        start_time,
        label,
        None,
    )
    print()
    conn.commit()
    print(f"Parsed {count} performance log entries")
    return (bytes_read_before + bytes_read_this_run, last_line_num)


def main():
    parser = argparse.ArgumentParser(
        description="Parse TaskVine logs into SQLite database"
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="query",
        choices=["query", "rebuild"],
        help="query: open or create DB (default). rebuild: rebuild DB from log files.",
    )
    parser.add_argument("directory", help="Directory containing log files")
    parser.add_argument(
        "--db", help="Database file name (default: logs.db in directory)", default=None
    )

    args = parser.parse_args()

    directory = Path(args.directory)
    if not directory.exists() or not directory.is_dir():
        print(f"Error: {directory} is not a valid directory")
        sys.exit(1)

    # Determine database file path
    if args.db:
        db_path = Path(args.db)
    else:
        db_path = directory / "logs.db"
        if args.command != "rebuild" and not db_path.exists():
            # Check for other common db file names when opening existing
            for db_name in ["vine-logs.db", "taskvine.db", "vine.db"]:
                candidate = directory / db_name
                if candidate.exists():
                    db_path = candidate
                    break

    # Rebuild: remove existing database so it will be recreated from logs
    if args.command == "rebuild" and db_path.exists():
        db_path.unlink()
        print(f"Removed existing database {db_path}. Rebuilding from log files.")

    # Check if database exists
    if db_path.exists():
        print(f"Database {db_path} already exists. Opening existing database.")
        conn = sqlite3.connect(str(db_path))
        conn.row_factory = sqlite3.Row
        # Set start_time_us from log_read_position first, then from data tables or log files
        global start_time_us
        start_time_us = get_start_time_us(conn)
        if start_time_us is None:
            try:
                cursor = conn.cursor()
                cursor.execute(
                    "SELECT MIN(time_us) FROM (SELECT MIN(time_us) FROM transactions UNION ALL "
                    "SELECT MIN(time_us) FROM performance UNION ALL SELECT MIN(time_us) FROM debug)"
                )
                result = cursor.fetchone()
                if result and result[0]:
                    start_time_us = result[0]
            except sqlite3.OperationalError:
                pass  # one or more tables may not exist
        if start_time_us is None:
            txn_log, perf_log, debug_log = find_log_files(directory)
            if txn_log or perf_log or debug_log:
                find_earliest_timestamp(txn_log, perf_log, debug_log)
        if start_time_us is not None:
            set_start_time_us(conn, start_time_us)
            print(f"Start time: {datetime.fromtimestamp(start_time_us / 1000000.0)}")
    else:
        # Find log files
        txn_log, perf_log, debug_log = find_log_files(directory)

        if not txn_log and not perf_log and not debug_log:
            print(f"Error: No log files found in {directory}")
            print("Looking for: transactions, performance, debug")
            sys.exit(1)

        print(f"Found log files:")
        if txn_log:
            print(f"  Transaction: {txn_log}")
        if perf_log:
            print(f"  Performance: {perf_log}")
        if debug_log:
            print(f"  Debug: {debug_log}")

        # Find earliest timestamp
        find_earliest_timestamp(txn_log, perf_log, debug_log)
        if start_time_us:
            print(f"Start time: {datetime.fromtimestamp(start_time_us / 1000000.0)}")

        # Create database
        conn = sqlite3.connect(str(db_path))
        conn.row_factory = sqlite3.Row
        if start_time_us is not None:
            set_start_time_us(conn, start_time_us)

        # Parse logs and save read positions for refresh
        if txn_log and txn_log.exists():
            print(f"\nParsing transaction log...")
            result = parse_transaction_log(conn, txn_log)
            if result:
                save_read_position(conn, "transactions", txn_log, result[0], result[1])

        if perf_log and perf_log.exists():
            print(f"\nParsing performance log...")
            result = parse_performance_log(conn, perf_log)
            if result is not None:
                save_read_position(conn, "performance", perf_log, result[0], result[1])

        if debug_log and debug_log.exists():
            print(f"\nParsing debug log...")
            result = parse_debug_log(conn, debug_log)
            if result:
                save_read_position(conn, "debug", debug_log, result[0], result[1])

        print(f"\nDatabase created: {db_path}")

    # History and db live in the input directory
    history_path = setup_readline_history(directory)

    def print_help():
        print("Available commands:")
        print("  tables                    - list table names")
        print(
            "  schema <table>            - show schema for a table (e.g. schema retrieved)"
        )
        print(
            "  lowcores <N>              - times when committed cores <= N% of total and tasks waiting"
        )
        print(
            "  train <N>                 - times when tasks_with_results > N% of tasks_on_workers"
        )
        print(
            "  maxdiffp <column> [N]     - top N deltas for a performance column (default N=5); shows delta value, delta time, and times"
        )
        print(
            "  maxdiffd [N]              - top N time gaps between consecutive performance rows (default N=5); sorts on time_us"
        )
        print(
            "  diff <time_us> [col ...]  - at row with time_us, print difference of performance columns vs previous and next row"
        )
        print(
            "                                 (if no columns given: tasks_waiting, tasks_on_workers, tasks_running, tasks_waiting_retrieval)"
        )
        print(
            "  task <N>                  - raw lines from transactions and debug log for task id N (sorted by time)"
        )
        print(
            "  time <spec> [range_sec]   - raw lines at absolute time (microseconds or YYYY/MM/DD-HH:MM:SS.nn); optional range in seconds"
        )
        print(
            "  timer <spec> [range_sec]  - raw lines at relative time (HH:MM:SS.nn or microseconds from start); optional range in seconds"
        )
        print(
            "  refresh                   - update DB from last read position (append new log data)"
        )
        print(
            "  sql <query>               - run SQL (or type query without 'sql' prefix)"
        )
        print(
            "  save <file>               - save last query result to file (reruns query if needed)"
        )
        print("  help                      - list available commands")
        print("  exit, quit, q             - exit")

    # Interactive SQL prompt
    print("\nEnter SQL queries (type 'help' for commands, 'exit' or 'quit' to exit):")
    print_help()

    last_query = None
    last_result = None  # (col_names, rows) from last SQL run

    while True:
        try:
            line = input("> ").strip()
            if not line:
                continue

            if line.lower() in ["exit", "quit", "q"]:
                break

            if line.lower() == "help":
                print_help()
                continue

            if line.lower() == "tables":
                cmd_tables(conn)
                continue

            if line.lower().startswith("schema "):
                table_name = line[7:].strip()
                cmd_schema(conn, table_name)
                continue

            if line.lower().startswith("lowcores "):
                arg = line[9:].strip()
                cmd_lowcores(conn, arg)
                continue

            if line.lower().startswith("train "):
                arg = line[6:].strip()
                cmd_train(conn, arg)
                continue

            if line.lower().startswith("maxdiffp "):
                rest = line[9:].strip().split()
                if not rest:
                    print("Usage: maxdiffp <column> [N]   (N defaults to 5)")
                    continue
                col_arg = rest[0]
                n_arg = None
                if len(rest) >= 2 and rest[1].isdigit() and int(rest[1]) > 0:
                    n_arg = rest[1]
                cmd_maxdiffp(conn, col_arg, n_arg)
                continue

            if line.lower().startswith("maxdiffd"):
                rest = line[8:].strip().split()
                n_arg = None
                if rest and rest[0].isdigit() and int(rest[0]) > 0:
                    n_arg = rest[0]
                cmd_maxdiffd(conn, n_arg)
                continue

            if line.lower().startswith("diff "):
                rest = line[5:].strip().split()
                if len(rest) < 1:
                    print("Usage: diff <time_us> [column ...]")
                    continue
                time_us_arg = rest[0]
                column_args = rest[1:]  # if empty, cmd_diff uses default columns
                cmd_diff(conn, time_us_arg, column_args)
                continue

            if line.lower().startswith("task "):
                arg = line[5:].strip()
                cmd_task(conn, arg)
                continue

            if line.lower().startswith("timer "):
                parts = line[6:].strip().split(None, 1)
                time_arg = parts[0] if parts else ""
                range_arg = parts[1] if len(parts) > 1 else None
                cmd_timer(conn, time_arg, range_arg)
                continue

            if line.lower().startswith("time "):
                parts = line[5:].strip().split()
                time_arg = parts[0] if parts else ""
                offset1 = parts[1] if len(parts) > 1 else None
                offset2 = parts[2] if len(parts) > 2 else None
                cmd_time(conn, time_arg, offset1, offset2)
                continue

            if line.lower() == "refresh":
                cmd_refresh(conn, directory)
                continue

            if line.lower().startswith("save "):
                name = line[5:].strip()
                if not name:
                    print("Usage: save <filename>")
                    continue
                if last_result is not None:
                    col_names, rows = last_result
                elif last_query is not None:
                    try:
                        cursor = conn.cursor()
                        cursor.execute(last_query)
                        rows = cursor.fetchall()
                        col_names = (
                            [d[0] for d in cursor.description]
                            if cursor.description
                            else []
                        )
                        last_result = (col_names, rows)
                    except Exception as e:
                        print(f"Error rerunning query: {e}")
                        continue
                else:
                    print("No previous query to save.")
                    continue
                header_line = " | ".join(str(c) for c in col_names)
                separator = "-" * max(60, len(header_line))
                lines = [header_line, separator]
                lines += [
                    " | ".join(str(val) if val is not None else "NULL" for val in row)
                    for row in rows
                ]
                try:
                    with open(name, "w") as f:
                        f.write("\n".join(lines) + "\n")
                    print(f"Saved {len(rows)} row(s) to {name}")
                except OSError as e:
                    print(f"Error writing to {name}: {e}")
                continue

            if line.lower().startswith("sql "):
                query = line[4:].strip()
            else:
                query = line

            cursor = conn.cursor()
            cursor.execute(query)

            # Fetch results
            rows = cursor.fetchall()
            col_names = (
                [description[0] for description in cursor.description]
                if cursor.description
                else []
            )
            last_query = query
            last_result = (col_names, rows)

            if rows:
                header_line = " | ".join(str(c) for c in col_names)
                separator = "-" * max(60, len(header_line))
                header_lines = [header_line, separator]
                lines = [
                    " | ".join(str(val) if val is not None else "NULL" for val in row)
                    for row in rows
                ]
                display_paged(lines, header_lines=header_lines)
                print(f"\n{len(rows)} row(s)")
            else:
                print("No results")

        except (KeyboardInterrupt, EOFError):
            print("\nExiting...")
            break
        except Exception as e:
            print(f"Error: {e}")

    save_readline_history(history_path)
    conn.close()


if __name__ == "__main__":
    main()
