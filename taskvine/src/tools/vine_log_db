def _parse_resource_values(obj):
    """Parse a resource/limits JSON object: each value is [value, unit]. Return dict name -> value (number only)."""
    if not obj or not isinstance(obj, dict):
        return {}
    out = {}
    for name, v in obj.items():
        if isinstance(v, (int, float)):
            out[name] = float(v) if isinstance(v, float) else v
        elif isinstance(v, (list, tuple)) and len(v) >= 1:
            val = v[0]
            if isinstance(val, (int, float)):
                out[name] = float(val) if isinstance(val, float) else val
    return out


def _resource_row_from_parsed(parsed):
    """Return a tuple of values in _RESOURCE_NAMES order for INSERT into resources table. Unknown keys omitted (None)."""
    return tuple(parsed.get(n) for n in _RESOURCE_NAMES)


def _parse_two_json_objects(s):
    """Parse two JSON objects from string s (limits then resources). Returns (limits_str, resources_str) or (None, None)."""
    s = s.strip()
    if not s or s[0] != "{":
        return None, None
    depth = 0
    i = 0
    while i < len(s):
        if s[i] == "{":
            depth += 1
        elif s[i] == "}":
            depth -= 1
            if depth == 0:
                first = s[: i + 1]
                rest = s[i + 1 :].strip()
                start2 = rest.find("{")
                if start2 < 0:
                    return first, None
                depth2 = 0
                j = start2
                while j < len(rest):
                    if rest[j] == "{":
                        depth2 += 1
                    elif rest[j] == "}":
                        depth2 -= 1
                        if depth2 == 0:
                            return first, rest[start2 : j + 1]
                    j += 1
                return first, None
        i += 1
    return None, None


# RETRIEVED line: TASK task_id RETRIEVED result exit_code {limits} {resources}
_RETRIEVED_RE = re.compile(
    r"TASK\s+(\d+)\s+RETRIEVED\s+"
    r"(SUCCESS|UNKNOWN|INPUT_MISSING|OUTPUT_MISSING|STDOUT_MISSING|SIGNAL|"
    r"RESOURCE_EXHAUSTION|MAX_RETRIES|MAX_END_TIME|MAX_WALL_TIME|FORSAKEN)\s+"
    r"(-?\d+)\s+(.+)$",
    re.DOTALL,
)


def parse_debug_timestamp(line):
    """Parse timestamp from debug log line (YYYY/MM/DD HH:MM:SS.CC format)."""
    match = _DEBUG_TIMESTAMP_RE.match(line)
    if match:
        year, month, day, hour, minute, second, centisecond = match.groups()
        try:
            dt = datetime(
                int(year),
                int(month),
                int(day),
                int(hour),
                int(minute),
                int(second),
                int(centisecond) * 10000,
            )
            return int(dt.timestamp() * 1000000)
        except Exception:
            pass
    return None


def extract_task_id_from_message(message):
    """Extract task_id from debug message."""
    if not message:
        return None

    # Pattern: "Task N" or "task N"
    task_match = re.search(r"\b[Tt]ask\s+(\d+)\b", message)
    if task_match:
        try:
            return int(task_match.group(1))
        except ValueError:
            pass

    # Pattern: "complete status exit_code output_length bytes_sent start_time end_time sandbox_used task_id"
    # task_id is the last number on the line (use greedy .* so we capture the last \d+)
    complete_match = re.search(r"\bcomplete\s+.*\s(\d+)\s*$", message)
    if complete_match:
        try:
            return int(complete_match.group(1))
        except ValueError:
            pass

    return None


def extract_host_port_from_message(message):
    """Extract hostname and port from debug message.
    Returns (hostname, port) or (None, None).
    Handles patterns like:
    - "rx from hostname (ip:port):"
    - "tx to hostname (ip:port):"
    - "hostname (ip:port)"
    """
    if not message:
        return None, None

    # Pattern: "rx from hostname (ip:port):" or "tx to hostname (ip:port):"
    rx_tx_pattern = re.compile(
        r"(?:rx\s+from|tx\s+to)\s+(\S+?)(?:\s+\(([^:]+):(\d+)\))?\s*:"
    )
    match = rx_tx_pattern.search(message)
    if match:
        hostname = match.group(1)
        port = None
        if match.group(3):
            try:
                port = int(match.group(3))
            except ValueError:
                pass
        return hostname, port

    # Pattern: "hostname (ip:port)" standalone
    host_port_pattern = re.compile(r"(\S+?)\s+\(([^:]+):(\d+)\)")
    match = host_port_pattern.search(message)
    if match:
        hostname = match.group(1)
        try:
            port = int(match.group(3))
        except ValueError:
            pass
        return hostname, port

    return None, None


def extract_file_from_message(message):
    """Extract filename from debug message.
    Looks for file patterns in messages including cached names, paths, etc.
    """
    if not message:
        return None

    for pattern in _FILE_TRANSFER_PATTERNS:
        match = pattern.search(message)
        if match:
            filename = match.group(1)
            if filename not in ("http", "https", "ftp", "GET", "POST"):
                return filename

    match = _FILE_EXT_PATTERN.search(message)
    if match:
        filename = match.group(1)
        if filename not in ("http", "https", "ftp"):
            return filename

    match = _FILE_PATH_PATTERN.search(message)
    if match:
        filename = match.group(1)
        if not filename.startswith(
            ("http://", "https://", "ftp://")
        ) and filename not in ("http", "https", "ftp"):
            return filename

    return None


def extract_received_sent(message):
    """Extract whether message is received or sent.
    Returns 'received', 'sent', or None.
    """
    if not message:
        return None

    message_lower = message.lower()
    if "rx from" in message_lower or "received" in message_lower:
        return "received"
    elif (
        "tx to" in message_lower
        or "sent" in message_lower
        or "sending" in message_lower
    ):
        return "sent"

    return None


def parse_worker_message(line):
    """Parse worker message based on vine_manager_recv_no_retry logic.
    Returns message type and parsed data.
    """
    line = line.strip()

    # Check for various message types from vine_manager_recv_no_retry
    if line.startswith("alive"):
        return "alive", {}
    elif line.startswith("taskvine"):
        # Format: taskvine protocol_version hostname os arch version
        parts = line.split(None, 5)
        if len(parts) >= 6:
            return "taskvine", {
                "protocol": parts[1] if len(parts) > 1 else None,
                "hostname": parts[2] if len(parts) > 2 else None,
                "os": parts[3] if len(parts) > 3 else None,
                "arch": parts[4] if len(parts) > 4 else None,
                "version": parts[5] if len(parts) > 5 else None,
            }
    elif (
        line.startswith("manager_status")
        or line.startswith("worker_status")
        or line.startswith("task_status")
        or line.startswith("wable_status")
        or line.startswith("resources_status")
    ):
        return "status", {"type": line.split()[0]}
    elif line.startswith("available_results"):
        return "available_results", {}
    elif line.startswith("resources"):
        return "resources", {}
    elif line.startswith("feature"):
        # Format: feature name
        parts = line.split(None, 1)
        return "feature", {"name": parts[1] if len(parts) > 1 else None}
    elif line.startswith("auth"):
        return "auth", {}
    elif line.startswith("name"):
        # Format: name hostname
        parts = line.split(None, 1)
        return "name", {"hostname": parts[1] if len(parts) > 1 else None}
    elif line.startswith("info"):
        return "info", {}
    elif line.startswith("cache-update"):
        # Format: cache-update filename type cache_level size mtime transfer_time start_time id
        parts = line.split()
        if len(parts) >= 9:
            return "cache-update", {
                "filename": parts[1] if len(parts) > 1 else None,
                "type": parts[2] if len(parts) > 2 else None,
                "cache_level": parts[3] if len(parts) > 3 else None,
                "size": parts[4] if len(parts) > 4 else None,
                "mtime": parts[5] if len(parts) > 5 else None,
                "transfer_time": parts[6] if len(parts) > 6 else None,
                "start_time": parts[7] if len(parts) > 7 else None,
                "id": parts[8] if len(parts) > 8 else None,
            }
        elif len(parts) >= 5:
            # Fallback for simpler format
            return "cache-update", {
                "filename": parts[1] if len(parts) > 1 else None,
                "size": parts[2] if len(parts) > 2 else None,
                "time_us": parts[3] if len(parts) > 3 else None,
                "start_time_us": parts[4] if len(parts) > 4 else None,
            }
    elif line.startswith("cache-invalid"):
        # Format: cache-invalid filename message
        parts = line.split(None, 2)
        return "cache-invalid", {
            "filename": parts[1] if len(parts) > 1 else None,
            "message": parts[2] if len(parts) > 2 else None,
        }
    elif line.startswith("transfer-hostport"):
        # Format: transfer-hostport host port
        parts = line.split()
        return "transfer-hostport", {
            "host": parts[1] if len(parts) > 1 else None,
            "port": parts[2] if len(parts) > 2 else None,
        }
    elif line.startswith("transfer-port"):
        # Format: transfer-port port
        parts = line.split()
        return "transfer-port", {"port": parts[1] if len(parts) > 1 else None}
    elif line.startswith("GET "):
        # HTTP request: GET path HTTP/1.1
        match = re.match(r"GET\s+(\S+)\s+HTTP", line)
        if match:
            return "http_request", {"path": match.group(1)}
    elif line.startswith("complete"):
        # Format: complete status exit_code output_length bytes_sent start_time end_time sandbox_used task_id
        parts = line.split()
        if len(parts) >= 9:
            return "complete", {
                "status": parts[1] if len(parts) > 1 else None,
                "exit_code": parts[2] if len(parts) > 2 else None,
                "output_length": parts[3] if len(parts) > 3 else None,
                "bytes_sent": parts[4] if len(parts) > 4 else None,
                "start_time": parts[5] if len(parts) > 5 else None,
                "end_time": parts[6] if len(parts) > 6 else None,
                "sandbox_used": parts[7] if len(parts) > 7 else None,
                "task_id": parts[8] if len(parts) > 8 else None,
            }

    return None, {}


def extract_tx_payload(message):
    """Extract the payload from a 'tx to host (port): <payload>' debug message.
    Returns the payload string (what was sent to the worker), or None if not a tx line.
    """
    if not message or "tx to " not in message:
        return None
    # Pattern: "tx to hostname (addr:port): <payload>"
    idx = message.find(": ")
    if idx < 0:
        return None
    payload = message[idx + 2 :].strip()  # after ": ", strip whitespace/newlines
    return payload if payload else None


def parse_manager_send_message(payload):
    """Parse vine_manager_send payload (manager-to-worker command).
    Payload is the string that was sent, e.g. 'task 123' or 'put file.txt 1 1024'.
    Returns (message_type, data_dict) or (None, {}).
    """
    if not payload:
        return None, {}
    line = payload.strip()
    if not line:
        return "empty", {}

    # Order matters: check longer/more specific prefixes first
    if line == "exit":
        return "exit", {}
    if line == "release":
        return "release", {}
    if line == "check":
        return "check", {}
    if line == "end":
        return "end", {}
    if line.startswith("HTTP/"):
        return "http_response", {"line": line[:80]}

    # kill task_id
    m = re.match(r"^kill\s+(\d+)\s*$", line)
    if m:
        return "kill", {"task_id": int(m.group(1))}

    # send_stdout task_id
    m = re.match(r"^send_stdout\s+(\d+)\s*$", line)
    if m:
        return "send_stdout", {"task_id": int(m.group(1))}

    # send_results task_id (can be -1)
    m = re.match(r"^send_results\s+(-?\d+)\s*$", line)
    if m:
        return "send_results", {"task_id": int(m.group(1))}

    # unlink filename
    m = re.match(r"^unlink\s+(.+)$", line)
    if m:
        return "unlink", {"filename": m.group(1).strip()}

    # task task_id
    m = re.match(r"^task\s+(\d+)\s*$", line)
    if m:
        return "task", {"task_id": int(m.group(1))}

    # cmd length
    m = re.match(r"^cmd\s+(\d+)\s*$", line)
    if m:
        return "cmd", {"length": int(m.group(1))}

    # put cached_name cache_level size
    m = re.match(r"^put\s+(\S+)\s+(\d+)\s+(\d+)\s*$", line)
    if m:
        return "put", {
            "cached_name": m.group(1),
            "cache_level": int(m.group(2)),
            "size": int(m.group(3)),
        }

    # get cached_name / getfile cached_name
    m = re.match(r"^get\s+(\S+)\s*$", line)
    if m:
        return "get", {"cached_name": m.group(1)}
    m = re.match(r"^getfile\s+(\S+)\s*$", line)
    if m:
        return "getfile", {"cached_name": m.group(1)}

    # file name size mode mtime
    m = re.match(r"^file\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s*$", line)
    if m:
        return "file", {
            "name": m.group(1),
            "size": int(m.group(2)),
            "mode": int(m.group(3)),
            "mtime": int(m.group(4)),
        }

    # dir name mode mtime
    m = re.match(r"^dir\s+(\S+)\s+(\d+)\s+(\d+)\s*$", line)
    if m:
        return "dir", {
            "name": m.group(1),
            "mode": int(m.group(2)),
            "mtime": int(m.group(3)),
        }

    # symlink remotename length
    m = re.match(r"^symlink\s+(\S+)\s+(\d+)\s*$", line)
    if m:
        return "symlink", {"remotename": m.group(1), "length": int(m.group(2))}

    # infile cached_name remote_name flags
    m = re.match(r"^infile\s+(\S+)\s+(\S+)\s+(\d+)\s*$", line)
    if m:
        return "infile", {
            "cached_name": m.group(1),
            "remote_name": m.group(2),
            "flags": int(m.group(3)),
        }

    # outfile cached_name remote_name flags
    m = re.match(r"^outfile\s+(\S+)\s+(\S+)\s+(\d+)\s*$", line)
    if m:
        return "outfile", {
            "cached_name": m.group(1),
            "remote_name": m.group(2),
            "flags": int(m.group(3)),
        }

    # category name
    m = re.match(r"^category\s+(.+)$", line)
    if m:
        return "category", {"name": m.group(1).strip()}

    # needs_library / provides_library name
    m = re.match(r"^needs_library\s+(.+)$", line)
    if m:
        return "needs_library", {"name": m.group(1).strip()}
    m = re.match(r"^provides_library\s+(.+)$", line)
    if m:
        return "provides_library", {"name": m.group(1).strip()}

    # groupid id
    m = re.match(r"^groupid\s+(\d+)\s*$", line)
    if m:
        return "groupid", {"group_id": int(m.group(1))}

    # function_slots n / func_exec_mode n
    m = re.match(r"^function_slots\s+(\d+)\s*$", line)
    if m:
        return "function_slots", {"n": int(m.group(1))}
    m = re.match(r"^func_exec_mode\s+(\d+)\s*$", line)
    if m:
        return "func_exec_mode", {"mode": int(m.group(1))}

    # cores / gpus / memory / disk / end_time / wall_time value
    for cmd in ("cores", "gpus", "memory", "disk", "end_time", "wall_time"):
        if line.startswith(cmd + " "):
            return cmd, {"value": line[len(cmd) + 1 :].strip()}

    # env length - payload is "N\ncontent", single line in log might be just "N"
    m = re.match(r"^env\s+(\d+)\s*$", line)
    if m:
        return "env", {"length": int(m.group(1))}

    # mini_task source cached_name cache_level size mode
    m = re.match(r"^mini_task\s+(\S+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s*$", line)
    if m:
        return "mini_task", {
            "source": m.group(1),
            "cached_name": m.group(2),
            "cache_level": int(m.group(3)),
            "size": int(m.group(4)),
            "mode": int(m.group(5)),
        }

    # puturl / puturl_now source cached_name cache_level size mode transfer_id
    m = re.match(
        r"^puturl_now\s+(\S+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s*$", line
    )
    if m:
        return "puturl_now", {
            "source": m.group(1),
            "cached_name": m.group(2),
            "cache_level": int(m.group(3)),
            "size": int(m.group(4)),
            "mode": int(m.group(5)),
            "transfer_id": m.group(6),
        }
    m = re.match(r"^puturl\s+(\S+)\s+(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s*$", line)
    if m:
        return "puturl", {
            "source": m.group(1),
            "cached_name": m.group(2),
            "cache_level": int(m.group(3)),
            "size": int(m.group(4)),
            "mode": int(m.group(5)),
            "transfer_id": m.group(6),
        }

    # Project name: blank or single word (no space), sent as manager name; avoid matching commands
    if "\n" not in line and " " not in line:
        return "project_name", {"name": line}

    return "unknown", {"raw": line[:256]}


def find_log_files(directory):
    """Find transaction, performance, and debug log files in directory."""
    dir_path = Path(directory)

    txn_log = None
    perf_log = None
    debug_log = None

    # Look for transaction log
    for pattern in ["transactions", "vine-transactions", "*transaction*", "*txn*"]:
        matches = list(dir_path.glob(pattern))
        if matches:
            txn_log = matches[0]
            break

    # Look for performance log
    for pattern in ["performance", "vine-performance", "*perf*"]:
        matches = list(dir_path.glob(pattern))
        if matches:
            perf_log = matches[0]
            break

    # Look for debug log
    for pattern in ["debug", "vine-debug", "*debug*"]:
        matches = list(dir_path.glob(pattern))
        if matches:
            debug_log = matches[0]
            break

    return txn_log, perf_log, debug_log


def ensure_log_read_position_table(conn):
    """Create table that stores last read position per log file (for refresh)."""
    conn.execute("""
        CREATE TABLE IF NOT EXISTS log_read_position (
            log_type TEXT PRIMARY KEY,
            file_path TEXT NOT NULL,
            last_byte_position INTEGER NOT NULL,
            last_line_number INTEGER NOT NULL,
            start_time_us INTEGER
        )
    """)
    try:
        conn.execute("ALTER TABLE log_read_position ADD COLUMN start_time_us INTEGER")
    except sqlite3.OperationalError:
        pass  # column already exists (new schema or already migrated)
    conn.commit()


def save_read_position(conn, log_type, file_path, last_byte_position, last_line_number):
    """Record the last byte and line number read for a log type (for refresh)."""
    ensure_log_read_position_table(conn)
    path_str = str(Path(file_path).resolve())
    conn.execute(
        """
        INSERT OR REPLACE INTO log_read_position
        (log_type, file_path, last_byte_position, last_line_number)
        VALUES (?, ?, ?, ?)
    """,
        (log_type, path_str, last_byte_position, last_line_number),
    )
    conn.commit()


def get_read_position(conn, log_type):
    """Return (file_path, last_byte_position, last_line_number) for log_type, or None."""
    cursor = conn.cursor()
    cursor.execute(
        "SELECT file_path, last_byte_position, last_line_number FROM log_read_position WHERE log_type = ?",
        (log_type,),
    )
    row = cursor.fetchone()
    if row is None:
        return None
    return {
        "file_path": row[0],
        "last_byte_position": row[1],
        "last_line_number": row[2],
    }


def get_start_time_us(conn):
    """Return stored start_time_us from log_read_position (_meta row), or None."""
    ensure_log_read_position_table(conn)
    cursor = conn.cursor()
    cursor.execute(
        "SELECT start_time_us FROM log_read_position WHERE log_type = '_meta' AND start_time_us IS NOT NULL"
    )
    row = cursor.fetchone()
    return row[0] if row else None


def set_start_time_us(conn, start_time_us):
    """Store start_time_us in log_read_position (_meta row) for reuse on reopen/refresh."""
    ensure_log_read_position_table(conn)
    conn.execute(
        """INSERT OR REPLACE INTO log_read_position
           (log_type, file_path, last_byte_position, last_line_number, start_time_us)
           VALUES ('_meta', '', 0, 0, ?)""",
        (start_time_us,),
    )
    conn.commit()


def find_earliest_timestamp(txn_log, perf_log, debug_log):
    """Find the earliest timestamp from all log files."""
    global start_time_us

    earliest = None

    # Scan transaction log
    if txn_log and txn_log.exists():
        with open(txn_log, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split(None, 2)
                if len(parts) >= 3:
                    timestamp_us = parse_timestamp_us(parts[0])
                    if timestamp_us is not None:
                        if earliest is None or timestamp_us < earliest:
                            earliest = timestamp_us
                        break

    # Scan performance log
    if perf_log and perf_log.exists():
        with open(perf_log, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if parts:
                    timestamp_us = parse_timestamp_us(parts[0])
                    if timestamp_us is not None:
                        if earliest is None or timestamp_us < earliest:
                            earliest = timestamp_us
                        break

    # Scan debug log
    if debug_log and debug_log.exists():
        with open(debug_log, "r") as f:
            for line in f:
                line = line.rstrip()
                if not line:
                    continue
                timestamp_us = parse_debug_timestamp(line)
                if timestamp_us is not None:
                    if earliest is None or timestamp_us < earliest:
                        earliest = timestamp_us
                    break

    if earliest is not None:
        start_time_us = earliest
    return earliest


def parse_debug_log(conn, log_file, start_byte=None, start_line_num=None):
    """Parse debug log file and insert into database.
    If start_byte and start_line_num are set, resume from that position (for refresh).
    Returns (last_byte_position, last_line_number) for saving read position.
    """
    global start_time_us

    cursor = conn.cursor()
    resume = start_byte is not None and start_line_num is not None
    if resume:
        next_line_num = start_line_num + 1
        bytes_read_before = start_byte
    else:
        next_line_num = 1
        bytes_read_before = 0

    # Create debug table with line numbers
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS debug (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            line_number INTEGER,
            time_us INTEGER,
            time_relative TEXT,
            program TEXT,
            pid INTEGER,
            child_pid INTEGER,
            flag TEXT,
            message TEXT,
            task_id INTEGER,
            host TEXT,
            port INTEGER,
            file TEXT,
            received_sent TEXT,
            worker_message_type TEXT,
            worker_message_data TEXT,
            send_message_type TEXT,
            send_message_data TEXT,
            raw_line TEXT
        )
    """)
    # Add send_message columns if table already existed
    for col in ("send_message_type", "send_message_data"):
        try:
            cursor.execute(f"ALTER TABLE debug ADD COLUMN {col} TEXT")
        except sqlite3.OperationalError:
            pass

    # Create indexes after bulk insert (faster than updating indexes per row)
    DEBUG_INSERT_SQL = """
        INSERT INTO debug
        (line_number, time_us, time_relative, program, pid, child_pid, flag, message,
         task_id, host, port, file, received_sent, worker_message_type, worker_message_data,
         send_message_type, send_message_data, raw_line)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """
    BATCH_SIZE = 5000

    total_bytes = max(1, log_file.stat().st_size)
    start_time = time.time()
    last_pct = None
    label = f"Parsing {log_file.name}" if not resume else f"Refreshing {log_file.name}"

    # Debug log format: YYYY/MM/DD HH:MM:SS.XX program[pid] <child:pid> flag: message
    debug_pattern = re.compile(
        r"(\d{4})/(\d{2})/(\d{2})\s+(\d{2}):(\d{2}):(\d{2})\.(\d{2})\s+"
        r"(\S+)\[(\d+)\](?:\s+<child:(\d+)>)?\s*(\S+):\s+(.*)"
    )

    batch = []
    count = 0
    last_line_num = start_line_num if resume else 0
    bytes_read_this_run = 0
    with open(log_file, "r") as f:
        if resume:
            f.seek(start_byte)
        for line in f:
            line_num = next_line_num
            next_line_num += 1
            last_line_num = line_num
            bytes_read_this_run += len(line.encode("utf-8", errors="replace"))
            last_bytes_read = bytes_read_before + bytes_read_this_run
            if line_num % 10000 == 0 or line_num == 1:
                last_pct = print_parse_progress(
                    last_bytes_read, total_bytes, line_num, start_time, label, last_pct
                )
            line = line.rstrip()
            if not line:
                continue

            match = debug_pattern.match(line)
            if not match:
                timestamp_us = parse_debug_timestamp(line)
                message = line
                if timestamp_us:
                    dt_match = _DEBUG_TIMESTAMP_RE.match(line)
                    if dt_match:
                        message = line[dt_match.end() :].strip()

                time_relative = format_relative_time(timestamp_us)
                task_id = extract_task_id_from_message(message)
                host, port = extract_host_port_from_message(message)
                file_name = extract_file_from_message(message)
                received_sent = extract_received_sent(message)

                worker_msg_type, worker_msg_data = parse_worker_message(message)
                worker_msg_json = (
                    json.dumps(worker_msg_data) if worker_msg_data else None
                )
                send_msg_type, send_msg_data = None, None
                if received_sent == "sent":
                    tx_payload = extract_tx_payload(message)
                    if tx_payload:
                        send_msg_type, send_msg_data = parse_manager_send_message(
                            tx_payload
                        )
                send_msg_json = json.dumps(send_msg_data) if send_msg_data else None

                row = (
                    line_num,
                    timestamp_us,
                    time_relative,
                    None,
                    None,
                    None,
                    None,
                    message,
                    task_id,
                    host,
                    port,
                    file_name,
                    received_sent,
                    worker_msg_type,
                    worker_msg_json,
                    send_msg_type,
                    send_msg_json,
                    line,
                )
                batch.append(row)
                count += 1
                if len(batch) >= BATCH_SIZE:
                    cursor.executemany(DEBUG_INSERT_SQL, batch)
                    batch = []
                continue

            year, month, day, hour, minute, second, centisecond = match.groups()[:7]
            program = match.group(8)
            pid = int(match.group(9))
            child_pid = int(match.group(10)) if match.group(10) else None
            flag = match.group(11)
            message = match.group(12)

            try:
                dt = datetime(
                    int(year),
                    int(month),
                    int(day),
                    int(hour),
                    int(minute),
                    int(second),
                    int(centisecond) * 10000,
                )
                timestamp_us = int(dt.timestamp() * 1000000)
            except Exception:
                timestamp_us = None
            if timestamp_us is None:
                continue

            time_relative = format_relative_time(timestamp_us)
            task_id = extract_task_id_from_message(message)
            host, port = extract_host_port_from_message(message)
            file_name = extract_file_from_message(message)
            received_sent = extract_received_sent(message)

            worker_msg_type, worker_msg_data = parse_worker_message(message)
            worker_msg_json = json.dumps(worker_msg_data) if worker_msg_data else None
            send_msg_type, send_msg_data = None, None
            if received_sent == "sent":
                tx_payload = extract_tx_payload(message)
                if tx_payload:
                    send_msg_type, send_msg_data = parse_manager_send_message(
                        tx_payload
                    )
            send_msg_json = json.dumps(send_msg_data) if send_msg_data else None

            row = (
                line_num,
                timestamp_us,
                time_relative,
                program,
                pid,
                child_pid,
                flag,
                message,
                task_id,
                host,
                port,
                file_name,
                received_sent,
                worker_msg_type,
                worker_msg_json,
                send_msg_type,
                send_msg_json,
                line,
            )
            batch.append(row)
            count += 1
            if len(batch) >= BATCH_SIZE:
                cursor.executemany(DEBUG_INSERT_SQL, batch)
                batch = []

    if batch:
        cursor.executemany(DEBUG_INSERT_SQL, batch)

    # Build indexes after all rows are inserted (much faster than per-row updates)
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_debug_time ON debug(time_us)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_debug_line ON debug(line_number)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_debug_task ON debug(task_id)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_debug_host ON debug(host)")
    cursor.execute("CREATE INDEX IF NOT EXISTS idx_debug_file ON debug(file)")
    cursor.execute(
        "CREATE INDEX IF NOT EXISTS idx_debug_send_type ON debug(send_message_type)"
    )

    print_parse_progress(
        bytes_read_before + bytes_read_this_run,
        total_bytes,
        last_line_num,
        start_time,
        label,
        None,
    )
    print()
    conn.commit()
    print(f"Parsed {count} debug log entries")
    return (bytes_read_before + bytes_read_this_run, last_line_num)


