#!/usr/bin/env python3
"""
Parse TaskVine transaction, performance, and debug logs into SQLite database.
Converts timestamps to microseconds and records line numbers.
Extracts attributes from debug statements (task_id, host, port, file, received/sent).
Parses worker messages based on vine_manager_recv_no_retry logic.
"""

import argparse
import sqlite3
import re
import sys
import time
from datetime import datetime
from pathlib import Path
import json
