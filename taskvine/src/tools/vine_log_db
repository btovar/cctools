def format_absolute_time(timestamp_us):
    """Convert timestamp (microseconds) to absolute datetime string."""
    if timestamp_us is None:
        return None
    try:
        timestamp_s = timestamp_us / 1000000.0
        dt = datetime.fromtimestamp(timestamp_s)
        microseconds = int(timestamp_us % 1000000)
        milliseconds = microseconds // 1000
        return dt.strftime("%Y-%m-%d %H:%M:%S") + f".{milliseconds:03d}"
    except (ValueError, OSError):
        return None


# Time spec parsing for "time" command: single number = microseconds;
# else HH:MM:SS.nn or HH:MM.SS.nn (relative) or YYYY/MM/DD-HH:MM:SS.nn (absolute).
_RELATIVE_TIME_RE = re.compile(r"^(\d{1,2}):(\d{1,2})[:.](\d{1,2})(?:\.(\d+))?$")
_ABSOLUTE_TIME_RE = re.compile(
    r"^(\d{4})/(\d{2})/(\d{2})-(\d{2}):(\d{2}):(\d{2})(?:\.(\d+))?$"
)


def parse_time_spec_to_us(
    spec_str, range_seconds=None, absolute_only=False, relative_only=False
):
    """
    Parse a time spec into (time_us_low, time_us_high).
    - Single integer: treated as microseconds (exact match: low=high=that value).
    - Otherwise: HH:MM:SS.nn or HH:MM.SS.nn (relative to start_time_us),
      or YYYY/MM/DD-HH:MM:SS.nn (absolute).
    - If range_seconds is given, high = low + range_seconds*1e6.
    - For time strings without range, the whole second is matched (low..low+1s).
    - absolute_only: only accept microseconds or YYYY/MM/DD-HH:MM:SS.nn.
    - relative_only: only accept HH:MM:SS.nn or a single integer (offset in microseconds from start).
    Returns (low_us, high_us) or (None, None) on parse error.
    """
    spec_str = (spec_str or "").strip()
    if not spec_str:
        return None, None

    # Single number → microseconds (absolute only)
    if not relative_only:
        try:
            us = int(spec_str)
            if range_seconds is not None:
                try:
                    r = float(range_seconds)
                    if r < 0:
                        return None, None
                    return us, int(us + r * 1_000_000)
                except (TypeError, ValueError):
                    return None, None
            return us, us
        except ValueError:
            pass

    # Relative: HH:MM:SS or HH:MM:SS.nn or HH:MM.SS.nn (allow : or . between MM and SS)
    if absolute_only:
        match = None
    else:
        match = _RELATIVE_TIME_RE.match(spec_str)
    if match:
        h, m, s, frac = match.groups()
        try:
            h, m, s = int(h), int(m), int(s)
            frac_us = 0
            if frac:
                frac_us = int(frac) * (10 ** (6 - len(frac)))
                if frac_us >= 1_000_000:
                    frac_us = 999_999
            total_us = (h * 3600 + m * 60 + s) * 1_000_000 + frac_us
        except (ValueError, TypeError):
            return None, None
        if start_time_us is None:
            return None, None
        low_us = start_time_us + total_us
        if range_seconds is not None:
            try:
                r = float(range_seconds)
                if r < 0:
                    return None, None
                return low_us, int(low_us + r * 1_000_000)
            except (TypeError, ValueError):
                return None, None
        # Match whole second: HH:MM:SS.*
        high_us = low_us + 1_000_000
        return low_us, high_us

    # Relative only: single integer = offset in microseconds from start
    if relative_only:
        try:
            offset_us = int(spec_str)
            if start_time_us is None:
                return None, None
            low_us = start_time_us + offset_us
            if range_seconds is not None:
                try:
                    r = float(range_seconds)
                    if r < 0:
                        return None, None
                    return low_us, int(low_us + r * 1_000_000)
                except (TypeError, ValueError):
                    return None, None
            return low_us, low_us
        except ValueError:
            pass

    # Absolute: YYYY/MM/DD-HH:MM:SS.nn
    if relative_only:
        match = None
    else:
        match = _ABSOLUTE_TIME_RE.match(spec_str)
    if match:
        y, mo, d, h, mi, sec, frac = match.groups()
        try:
            y, mo, d = int(y), int(mo), int(d)
            h, mi, sec = int(h), int(mi), int(sec)
            frac_us = 0
            if frac:
                frac_us = int(frac[:6]) * (10 ** (6 - min(len(frac), 6)))
            if frac_us >= 1_000_000:
                frac_us = 999_999
            dt = datetime(y, mo, d, h, mi, sec, frac_us)
            low_us = int(dt.timestamp() * 1_000_000)
        except (ValueError, TypeError):
            return None, None
        if range_seconds is not None:
            try:
                r = float(range_seconds)
                if r < 0:
                    return None, None
                return low_us, int(low_us + r * 1_000_000)
            except (TypeError, ValueError):
                return None, None
        high_us = low_us + 1_000_000
        return low_us, high_us

    return None, None


def cmd_lowcores(conn, n):
    """Print times when committed_cores <= N% of total_cores and tasks_waiting > 0."""
    cursor = conn.cursor()
    cursor.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='performance'"
    )
    if not cursor.fetchone():
        print("Error: No performance table in database.")
        return
    cursor.execute("PRAGMA table_info(performance)")
    cols = [row[1] for row in cursor.fetchall()]
    committed_col = total_col = tasks_waiting_col = None
    for c in cols:
        cnorm = c.lower().replace("_", "")
        if cnorm == "committedcores":
            committed_col = c
        elif cnorm == "totalcores":
            total_col = c
        elif cnorm == "taskswaiting":
            tasks_waiting_col = c
    if not committed_col or not total_col or not tasks_waiting_col:
        print(
            "Error: performance table missing committed_cores, total_cores, or tasks_waiting."
        )
        return
    try:
        pct = float(n)
    except (TypeError, ValueError):
        print("Usage: lowcores <N>   (N = percentage, e.g. 50)")
        return
    if pct < 0 or pct > 100:
        print("Error: N must be between 0 and 100.")
        return
    threshold = pct / 100.0
    query = f"""
        SELECT time_us, time_relative, {committed_col}, {total_col},
               {tasks_waiting_col},
               100.0 * {committed_col} / NULLIF({total_col}, 0) AS pct_used
        FROM performance
        WHERE {total_col} > 0
          AND (1.0 * {committed_col} / NULLIF({total_col}, 0)) <= ?
          AND {tasks_waiting_col} > 0
        ORDER BY time_us
    """
    cursor.execute(query, (threshold,))
    rows = cursor.fetchall()
    if not rows:
        print(
            f"No times found where committed cores <= {pct}% of total with tasks waiting."
        )
        return
    header_lines = [
        f"Times when committed cores <= {pct}% of total and tasks_waiting > 0 ({len(rows)} row(s)):",
        "",
        f"{'time_us':<20} {'time_relative':<16} {'committed':<12} {'total':<12} {'% used':<10} {'tasks_waiting':<14}",
        "-" * 90,
    ]
    lines = []
    for row in rows:
        time_us, time_rel, committed, total, waiting, pct_used = row
        c = committed if committed is not None else 0
        t = total if total is not None else 0
        p = pct_used if pct_used is not None else 0
        w = waiting if waiting is not None else 0
        lines.append(
            f"{time_us:<20} {(time_rel or 'N/A'):<16} {c:<12.1f} {t:<12.1f} {p:<10.2f} {w:<14.0f}"
        )
    display_paged(lines, header_lines=header_lines)


def cmd_train(conn, n):
    """Print times when (tasks_with_results / tasks_on_workers) * 100 > N%."""
    cursor = conn.cursor()
    cursor.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='performance'"
    )
    if not cursor.fetchone():
        print("Error: No performance table in database.")
        return
    cursor.execute("PRAGMA table_info(performance)")
    cols = [row[1] for row in cursor.fetchall()]
    with_results_col = on_workers_col = None
    for c in cols:
        cnorm = c.lower().replace("_", "")
        if cnorm == "taskswithresults":
            with_results_col = c
        elif cnorm == "tasksonworkers":
            on_workers_col = c
    if not with_results_col or not on_workers_col:
        print(
            "Error: performance table missing tasks_with_results or tasks_on_workers."
        )
        return
    try:
        pct = float(n)
    except (TypeError, ValueError):
        print("Usage: train <N>   (N = percentage, e.g. 50)")
        return
    if pct < 0 or pct > 100:
        print("Error: N must be between 0 and 100.")
        return
    threshold = pct / 100.0
    query = f"""
        SELECT time_us, time_relative, {with_results_col}, {on_workers_col},
               100.0 * {with_results_col} / NULLIF({on_workers_col}, 0) AS pct_results
        FROM performance
        WHERE {on_workers_col} > 0
          AND (1.0 * {with_results_col} / NULLIF({on_workers_col}, 0)) > ?
        ORDER BY time_us
    """
    cursor.execute(query, (threshold,))
    rows = cursor.fetchall()
    if not rows:
        print(f"No times found where tasks_with_results > {pct}% of tasks_on_workers.")
        return
    header_lines = [
        f"Times when tasks_with_results > {pct}% of tasks_on_workers ({len(rows)} row(s)):",
        "",
        f"{'time_us':<20} {'time_relative':<16} {'with_results':<14} {'on_workers':<12} {'% results':<12}",
        "-" * 80,
    ]
    lines = []
    for row in rows:
        time_us, time_rel, with_res, on_work, pct_results = row
        wr = with_res if with_res is not None else 0
        ow = on_work if on_work is not None else 0
        p = pct_results if pct_results is not None else 0
        lines.append(
            f"{time_us:<20} {(time_rel or 'N/A'):<16} {wr:<14.1f} {ow:<12.1f} {p:<12.2f}"
        )
    display_paged(lines, header_lines=header_lines)


def cmd_task(conn, task_id_str):
