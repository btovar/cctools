#!/usr/bin/env python3
"""
Parse TaskVine transaction, performance, and debug logs into SQLite database.
Converts timestamps to microseconds and records line numbers.
Extracts attributes from debug statements (task_id, host, port, file, received/sent).
Parses worker messages based on vine_manager_recv_no_retry logic.
"""

import argparse
import sqlite3
import re
import sys
import time
from datetime import datetime
from pathlib import Path
import json
import shutil

# Readline for input history (Unix; optional on Windows)
try:
    import readline

    HAS_READLINE = True
except ImportError:
    HAS_READLINE = False

# Termios/tty for raw key paging (Unix)
try:
    import termios
    import tty

    HAS_TERMIOS = True
except ImportError:
    HAS_TERMIOS = False


def get_terminal_size():
    """Return (rows, cols). Default (24, 80) if unavailable."""
    try:
        size = shutil.get_terminal_size()
        return size.lines, size.columns
    except Exception:
        return 24, 80


def print_parse_progress(
    bytes_read, total_bytes, line_num, start_time, label, last_printed_pct=None
):
    """Print progress and ETA from byte position; throttle to ~5% steps. Returns last_printed_pct."""
    if total_bytes <= 0:
        return last_printed_pct
    pct = 100.0 * bytes_read / total_bytes
    pct_floor = int(pct // 5) * 5
    if (
        last_printed_pct is not None
        and pct_floor <= last_printed_pct
        and bytes_read < total_bytes
    ):
        return last_printed_pct
    elapsed = time.time() - start_time
    if bytes_read > 0 and bytes_read < total_bytes:
        eta_sec = elapsed * (total_bytes - bytes_read) / bytes_read
        eta_str = f"ETA {int(eta_sec // 60)}:{int(eta_sec % 60):02d}"
    else:
        eta_str = "done"
    elapsed_str = f"{int(elapsed // 60)}:{int(elapsed % 60):02d}"
    print(
        f"\r{label}: {pct:.1f}% ({line_num:,} lines) elapsed {elapsed_str} {eta_str}   ",
        end="",
        flush=True,
    )
    return pct_floor


def display_paged(lines, header_lines=None):
    """
    Display lines with paging. Headers are shown on every page.
    Navigate: next [n/Space/Enter], prev [p], first [f], last [l], quit [q].
    """
    if not lines:
        return
    header_lines = header_lines or []
    rows, _ = get_terminal_size()
    # Reserve lines for status and prompt
    header_count = len(header_lines)
    page_size = max(1, rows - 6 - header_count)
    total_pages = (len(lines) + page_size - 1) // page_size

    if total_pages <= 1:
        for h in header_lines:
            print(h)
        for line in lines:
            print(line)
        return

    use_raw = HAS_TERMIOS
    if use_raw:
        try:
            termios.tcgetattr(sys.stdin)
        except (termios.error, AttributeError, OSError):
            use_raw = False

    current_page = 0
    while True:
        print("\n" * 2)
        for h in header_lines:
            print(h)
        start_idx = current_page * page_size
        end_idx = min(start_idx + page_size, len(lines))
        for i in range(start_idx, end_idx):
            print(lines[i])
        print(
            f"\n--- Page {current_page + 1}/{total_pages} (rows {start_idx + 1}-{end_idx} of {len(lines)}) ---"
        )
        print("[n]ext / [p]rev / [f]irst / [l]ast / [q]uit (Space/Enter=next)")

        try:
            if use_raw:
                old = termios.tcgetattr(sys.stdin)
                tty.setraw(sys.stdin.fileno())
                try:
                    key = sys.stdin.read(1)
                    if key == "\x1b":
                        try:
                            k2 = sys.stdin.read(1)
                            if k2 == "[":
                                k3 = sys.stdin.read(1)
                                if k3 == "5":
                                    key = "p"
                                elif k3 == "6":
                                    key = "n"
                                elif k3 == "A":
                                    key = "p"
                                elif k3 == "B":
                                    key = "n"
                                else:
                                    try:
                                        sys.stdin.read(1)
                                    except Exception:
                                        pass
                                    continue
                            else:
                                continue
                        except Exception:
                            continue
                finally:
                    termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
            else:
                cmd = input("\n[n]ext/[p]rev/[f]irst/[l]ast/[q]uit: ").strip().lower()
                key = (cmd or "q")[0]

            key = key.lower()
            if key == "q" or key == "\x03":
                break
            if key in ("n", " ", "\r"):
                if current_page < total_pages - 1:
                    current_page += 1
                else:
                    print("\nAlready at last page")
                    import time

                    time.sleep(0.5)
            elif key == "p":
                if current_page > 0:
                    current_page -= 1
                else:
                    print("\nAlready at first page")
                    import time

                    time.sleep(0.5)
            elif key == "f":
                current_page = 0
            elif key == "l":
                current_page = total_pages - 1
        except (KeyboardInterrupt, EOFError):
            break
        except Exception:
            try:
                cmd = input("\n[n]ext/[p]rev/[q]uit: ").strip().lower()
                if not cmd or cmd == "q":
                    break
                if cmd == "n" and current_page < total_pages - 1:
                    current_page += 1
                elif cmd == "p" and current_page > 0:
                    current_page -= 1
                elif cmd == "f":
                    current_page = 0
                elif cmd == "l":
                    current_page = total_pages - 1
            except (KeyboardInterrupt, EOFError):
                break


# Global start time for relative time conversion
start_time_us = None

# Precompiled regexes for debug log parsing (avoid recompiling per line)
_DEBUG_TIMESTAMP_RE = re.compile(
    r"(\d{4})/(\d{2})/(\d{2})\s+(\d{2}):(\d{2}):(\d{2})\.(\d{2})"
)
_FILE_TRANSFER_PATTERNS = [
    re.compile(r"sending\s+back\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"return\s+([a-zA-Z0-9_./-]+)\s+to", re.IGNORECASE),
    re.compile(r"output\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"file\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"filename[:\s]+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"invalidated\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"cache-update\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"cache-invalid\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"TRANSFER\s+(?:INPUT|OUTPUT)\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
    re.compile(r"CACHE_UPDATE\s+([a-zA-Z0-9_./-]+)", re.IGNORECASE),
]
_FILE_EXT_PATTERN = re.compile(
    r"\b([a-zA-Z0-9_./-]+\.(?:txt|log|out|err|dat|json|xml|gz|tar|zip|py|sh|c|h|cpp|hpp))\b"
)
_FILE_PATH_PATTERN = re.compile(r"\b([a-zA-Z0-9_./-]+/[a-zA-Z0-9_./-]+)\b")


def parse_timestamp_us(timestamp_str):
    """Parse timestamp string to microseconds since epoch."""
    try:
        return int(timestamp_str)
    except ValueError:
        return None


def format_relative_time(timestamp_us):
    """Convert timestamp to hh:mm:ss.nnn format relative to start time."""
    if start_time_us is None or timestamp_us is None:
        return None

    delta_us = timestamp_us - start_time_us
    if delta_us < 0:
        return None

    total_seconds = delta_us // 1000000
    microseconds = delta_us % 1000000
    milliseconds = microseconds // 1000

    hours = total_seconds // 3600
    minutes = (total_seconds % 3600) // 60
    seconds = total_seconds % 60

    return f"{hours:02d}:{minutes:02d}:{seconds:02d}.{milliseconds:03d}"


def _first_number_from_json_obj(obj):
    """Extract the first numeric value from a JSON object (dict, list, or scalar). Drops units from strings."""
    if obj is None:
        return None
    if isinstance(obj, (int, float)):
        return float(obj) if isinstance(obj, float) else int(obj)
    if isinstance(obj, str):
        # Drop units: take leading digits and optional decimal
        m = re.match(r"[-+]?\d*\.?\d+", obj.strip())
        return float(m.group(0)) if m else None
    if isinstance(obj, dict):
        for v in obj.values():
            n = _first_number_from_json_obj(v)
            if n is not None:
                return n
        return None
    if isinstance(obj, list):
        for v in obj:
            n = _first_number_from_json_obj(v)
            if n is not None:
                return n
        return None
    return None


