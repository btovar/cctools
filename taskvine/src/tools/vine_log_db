def _show_lines_in_time_range(conn, low_us, high_us):
    """Query debug, transactions, and performance for low_us..high_us and display with [D:line_no]/[T:line_no]/[P:line_no]."""
    cursor = conn.cursor()
    rows = []
    cursor.execute(
        "SELECT time_us, line_number, raw_line FROM debug WHERE time_us IS NOT NULL AND time_us >= ? AND time_us <= ?",
        (low_us, high_us),
    )
    for r in cursor.fetchall():
        rows.append((r[0], "D", r[1], r[2] or ""))
    cursor.execute(
        "SELECT time_us, line_number, raw_line FROM transactions WHERE time_us IS NOT NULL AND time_us >= ? AND time_us <= ?",
        (low_us, high_us),
    )
    for r in cursor.fetchall():
        rows.append((r[0], "T", r[1], r[2] or ""))

    # Add performance log rows in time range if performance table exists
    cursor.execute(
        f"SELECT time_us, line_number FROM performance WHERE time_us IS NOT NULL AND time_us >= ? AND time_us <= ?",
        (low_us, high_us),
    )
    for r in cursor.fetchall():
        time_us, line_no = r[0], r[1]
        rows.append((time_us, "P", time_us, line_no))

    rows.sort(key=lambda x: (x[0], x[1]))
    if not rows:
        print(f"No log lines in time range {low_us}–{high_us}.")
        return
    lines = [f"[{tag}:{line_no}] {raw_line}" for (_, tag, line_no, raw_line) in rows]
    display_paged(
        lines,
        header_lines=[
            f"Log lines (debug [D], transactions [T], performance [P]) in time range ({len(lines)} line(s)), sorted by time:",
            "",
        ],
    )


def cmd_time(conn, time_arg, offset1=None, offset2=None):
    """Show raw lines in the time range [time_us + min(offset1, offset2), time_us + max(offset1, offset2)]."""
    base_low, base_high = parse_time_spec_to_us(time_arg, None, absolute_only=True)
    if base_low is None or base_high is None:
        print("Usage: time <time_us> [offset1] [offset2]")
        print(
            "  time_us: absolute time — microseconds (e.g. 1234567890123456) or YYYY/MM/DD-HH:MM:SS.nn"
        )
        print(
            "  offset1, offset2: optional integers (microseconds), default 0; range is time_us + min(offset1, offset2) .. time_us + max(offset1, offset2)"
        )
        return
    base_us = base_low
    try:
        o1 = int(offset1) if offset1 is not None else 0
    except (TypeError, ValueError):
        o1 = 0
    try:
        o2 = int(offset2) if offset2 is not None else 0
    except (TypeError, ValueError):
        o2 = 0
    low_us = base_us + min(o1, o2)
    high_us = base_us + max(o1, o2)
    # When both offsets are 0, use a 1-second window so we show lines "at" that time instead of requiring an exact microsecond match
    if low_us == high_us:
        high_us = low_us + 1_000_000
    _show_lines_in_time_range(conn, low_us, high_us)


def cmd_timer(conn, time_arg, range_arg=None):
    """Show raw lines at the given relative time (HH:MM:SS.nn from start)."""
    low_us, high_us = parse_time_spec_to_us(time_arg, range_arg, relative_only=True)
    if low_us is None or high_us is None:
        print("Usage: timer <time_spec> [range_seconds]")
        print(
            "  time_spec: relative time — HH:MM:SS.nn, HH:MM.SS.nn, or microseconds from log start"
        )
        print(
            "  range_seconds: optional; if given, show lines in [time_spec, time_spec + range_seconds]"
        )
        return
    _show_lines_in_time_range(conn, low_us, high_us)


def cmd_maxdiffp(conn, column_arg, n_arg):
    """Show the maximum N deltas for a performance column, with time deltas and times at which they occurred."""
    cursor = conn.cursor()
    cursor.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='performance'"
    )
    if not cursor.fetchone():
        print("Error: No performance table in database.")
        return
    cursor.execute("PRAGMA table_info(performance)")
    all_cols = [row[1] for row in cursor.fetchall()]
    # Data columns (exclude id, line_number, time_us, time_relative)
    skip = {"id", "line_number", "time_relative"}
    data_cols = [c for c in all_cols if c not in skip]
    if not data_cols:
        print("Error: No data columns in performance table.")
        return
    # Match column (case-insensitive)
    col_lower = column_arg.strip().lower()
    chosen = None
    for c in data_cols:
        if c.lower() == col_lower:
            chosen = c
            break
    if chosen is None:
        print(f"Error: Column '{column_arg}' not found in performance table.")
        print(f"Available columns: {', '.join(data_cols)}")
        return
    try:
        n = int(n_arg) if n_arg is not None else 5
    except (TypeError, ValueError):
        n = 5
    if n < 1:
        print("Error: N must be a positive integer.")
        return
    query = f"SELECT time_us, time_relative, {chosen} FROM performance ORDER BY time_us"
    cursor.execute(query)
    rows = cursor.fetchall()
    if len(rows) < 2:
        print("Need at least two performance rows to compute deltas.")
        return
    deltas = []
    for i in range(1, len(rows)):
        prev = rows[i - 1]
        curr = rows[i]
        time_us, time_rel, val = prev[0], prev[1], prev[2]
        time_us_next, _, val_next = curr[0], curr[1], curr[2]
        if val is None or val_next is None:
            continue
        delta_value = val_next - val
        delta_time_us = time_us_next - time_us if (time_us_next is not None and time_us is not None) else None
        deltas.append((val, val_next, delta_value, delta_time_us, time_us, time_rel))
    if not deltas:
        print("No deltas (all values or times missing).")
        return
    # Top N by absolute delta value
    deltas.sort(key=lambda x: abs(x[2]), reverse=True)
    top = deltas[:n]
    header_lines = [
        f"Top {len(top)} delta(s) for column '{chosen}' (by absolute change):",
        "",
        f"{'val':<20} {'val_next':<20} {'delta_value':<20} {'delta_time_sec':<16} {'time_us':<20} {'time_rel':<20}",
        "-" * (20 + 20 + 20 + 16 + 20 + 20),
    ]
    lines = []
    for val, val_next, delta_value, delta_time_us, time_us, time_rel in top:
        delta_sec = (delta_time_us / 1_000_000.0) if delta_time_us is not None else None
        delta_sec_str = f"{delta_sec:.6f}" if delta_sec is not None else "N/A"
        time_us_str = str(time_us) if time_us is not None else "N/A"
        time_rel_str = str(time_rel) if time_rel is not None else "N/A"
        lines.append(
            f"{val:<20} {val_next:<20} {delta_value:<20} {delta_sec_str:<16} {time_us_str:<20} {time_rel_str:<20}"
        )
    display_paged(lines, header_lines=header_lines)


def cmd_maxdiffd(conn, n_arg):
    """Show the maximum N time deltas (gaps between consecutive performance rows). Always uses time_us order."""
    cursor = conn.cursor()
    try:
        n = int(n_arg) if n_arg is not None else 5
    except (TypeError, ValueError):
        n = 5
    if n < 1:
        print("Error: N must be a positive integer.")
        return
    cursor.execute(
        "SELECT time_us, time_relative FROM debug ORDER BY time_us"
    )
    rows = cursor.fetchall()
    if len(rows) < 2:
        print("Need at least two performance rows to compute time deltas.")
        return
    deltas = []
    for i in range(1, len(rows)):
        time_us_prev, time_rel_prev = rows[i - 1][0], rows[i - 1][1]
        time_us_curr, time_rel_curr = rows[i][0], rows[i][1]
